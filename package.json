{
  "name": "news-pocket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --local --port 8787",
    "db:local": "wrangler d1 migrations apply news-pocket-db --config wrangler.local.jsonc --local",
    "db:remote": "wrangler d1 migrations apply news-pocket-db --remote",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir build",
    "deploy": "node scripts/deploy.mjs",
    "collect": "node scripts/collect.mjs",
    "connect:google": "node scripts/connect-google.mjs",
    "connect:collection": "node scripts/connect-collection.mjs",
    "connect:operator": "node scripts/connect-operator.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "miniflare": "5.20261012.0-beta"
  }
}
